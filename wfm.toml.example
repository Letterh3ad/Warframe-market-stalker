# Copy to wfm.toml (gitignored) and edit. Values here are the tuned analyzer
# thresholds from Task 9 (see DECISIONS.md 2026-09-02).

pid_file = "wfm.pid"  # Where `wfm daemon start/stop/status` tracks the running daemon's pid.
gui_host = "127.0.0.1"  # Interface the embedded GUI server binds to. 127.0.0.1 = local only.
gui_port = 8420

# Adaptive polling weights for priority scoring.
w_vol = 1.0              # Volatility weight in priority score.
w_liq = 0.5              # Liquidity (volume) weight in priority score.
w_spread = 0.8           # Bid-ask spread weight in priority score.
w_pin = 1.5              # Manual pin weight in priority score.
score_saturation = 1.0   # Score value at which interval reaches ceiling.
decay_after_unchanged_polls = 3  # Polls before deprioritizing an unchanged item.
catchup_max_items = 25  # Overdue items released as due-now after a restart; the rest spread out.

[analyzers.revert]
# Robust-z gate on the 90-day close window. Hit rate was flat at ~0.72-0.74 across
# z 1.0-3.0 on the only replay window the stored history supports (2026-08-23..25,
# 2-3 day forward horizon); 2.0 is the hit-rate peak and a standard 2-sigma cut.
z_threshold = 2.0

[analyzers.flip]
# Not validated by replay: the harness has no order-book history, so every margin
# value produced zero signals. These are design defaults, to be tuned on live
# signals in phase 7.
min_margin_pct = 0.15
min_margin_plat = 12
